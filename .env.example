# ============================================================
#  URYX — Ortam Değişkenleri
#  Kullanım:  copy .env.example .env
# ============================================================

# ------------------------------------------------------------
# Portlar (host tarafı). Hepsi 127.0.0.1'e bind edilir.
# ------------------------------------------------------------
URYX_API_PORT=8080
# Host port for llama-server (legacy alias: VLLM_PORT)
LLM_PORT=8000
VLLM_PORT=8000
QDRANT_PORT=6333
POSTGRES_PORT=5432
WHISPER_PORT=8090
TTS_PORT=8091

# ------------------------------------------------------------
# Güvenlik
#   Boş bırakılırsa auth devre dışı kalır (yalnız geliştirme).
#   Üretimde:  powershell -c "[guid]::NewGuid().ToString('N')"
# ------------------------------------------------------------
URYX_LOCAL_TOKEN=
URYX_BIND_HOST=127.0.0.1
URYX_CORS_ORIGINS=http://localhost:5173,app://.

# Dosya erişimine izin verilen kökler (';' ile ayrılır, Windows yolları).
# Boş bırakılırsa Electron kullanıcının Documents/Desktop/Downloads
# klasörlerini otomatik ekler.
URYX_ALLOWED_PATHS=

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_local_dev_password
POSTGRES_DB=jarvis
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_local_dev_password@postgres:5432/jarvis

# ------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_MEMORY=uryx_memory
QDRANT_COLLECTION_DOCUMENTS=uryx_documents
QDRANT_COLLECTION_CONVERSATIONS=uryx_conversations
QDRANT_COLLECTION_CODE=uryx_code

# ------------------------------------------------------------
# LLM — llama.cpp (OpenAI /v1, GGUF)
# İndirme: .\scripts\pull-llm-gguf.ps1
# ------------------------------------------------------------
# API hâlâ VLLM_URL okur (geriye uyum); compose host adı llm.
VLLM_URL=http://llm:8000/v1
LLM_URL=http://llm:8000/v1
VLLM_API_KEY=EMPTY
# Küçük GGUF (Q4). Taze kurulum: 8B kalite. 4B-Instruct-2507 dengeli; 1.7B hızlı.
# Installer ve geliştirme aynı kök: %LOCALAPPDATA%\Uryx\models
# Docker Compose bu yolu LLM_MODELS_DIR ile bağlar (boşsa ./models).
LLM_MODELS_DIR=
LLM_MODEL=qwen3-8b
LLM_GGUF_FILE=Qwen3-8B-Q4_K_M.gguf
LLM_MAX_MODEL_LEN=8192
LLM_N_GPU_LAYERS=99
# off | on | auto — varsayılan off (istemci enable_thinking ile de kontrol eder)
LLM_REASONING=off
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=180
# İsteğe bağlı imaj sabitleme: LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# Eski vLLM knobs (LLM_QUANTIZATION, LLM_GPU_MEMORY_UTILIZATION, LLM_MAX_NUM_SEQS) yok sayılır.
# Hugging Face token (pull script / gated dosya)
HUGGING_FACE_HUB_TOKEN=

# İsteğe bağlı hibrit zekâ. Canlı (Live) API yok; OpenAI uyumlu HTTPS.
# Ayarlar'dan yapıştırılan anahtar sağlayıcıyı algılar (OpenAI, Gemini, Groq,
# OpenRouter, DeepSeek, xAI, Mistral). .env yedek olarak kalır.
# Basit ve özel turlar yerelde kalır, karmaşık araştırma/planlama buluta yükseltilir.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_REQUEST_TIMEOUT=180
LLM_ROUTING_MODE=hybrid
# true yapılırsa belge/hafıza/yerel araç sonuçları da buluta gönderilebilir.
GEMINI_ALLOW_PRIVATE_CONTEXT=false

# ------------------------------------------------------------
# Embedding (CPU)
# ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# ------------------------------------------------------------
# RAG
# ------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MIN_SCORE=0.25
RAG_MAX_FILE_MB=50
RAG_NEIGHBOR_WINDOW=1
RAG_MIN_CHUNK_CHARS=180
RAG_MMR_LAMBDA=0.72
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu

# ------------------------------------------------------------
# Hafıza
# ------------------------------------------------------------
MEMORY_AUTO_ENABLED=true
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.20
MEMORY_EVALUATOR_MAX_TOKENS=512
MEMORY_RECENCY_HALF_LIFE_DAYS=14
MEMORY_SEMANTIC_DEDUP_SCORE=0.93
MEMORY_EPISODE_ENABLED=true
MEMORY_CORE_MIN_IMPORTANCE=0.8
MEMORY_CORE_SLOTS=2

# ------------------------------------------------------------
# STT — Faster-Whisper
# Whisper varsayılanı CPU (int8). GPU için: WHISPER_DEVICE=cuda + WHISPER_COMPUTE_TYPE=float16
# GPU Whisper için: WHISPER_DEVICE=cuda + WHISPER_COMPUTE_TYPE=float16
# ------------------------------------------------------------
WHISPER_URL=http://whisper:8090
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=tr
WHISPER_VAD_FILTER=true
WHISPER_BEAM_SIZE=5
WHISPER_SHORT_UTTERANCE_SEC=4
WHISPER_NO_SPEECH=0.65
WHISPER_MIN_LOGPROB=-1.15
WHISPER_MAX_COMPRESSION=2.4

# ------------------------------------------------------------
# TTS — Piper
# ------------------------------------------------------------
TTS_URL=http://tts:8091
TTS_VOICE=tr_TR-dfki-medium
TTS_SPEED=1.0
TTS_VOLUME=1.0
TTS_ENABLED=true
TTS_SENTENCE_STREAMING=true

# Wake word — kullanılmaz. Asıl kaynak masaüstü Ayarlar (electron-store).
# WAKE_WORD_ENABLED=false
# WAKE_WORD=uryx
# WAKE_WORD_SENSITIVITY=0.6

# ------------------------------------------------------------
# Sistem / gözlemlenebilirlik
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
SYSTEM_METRICS_INTERVAL=3
DOCKER_HEALTH_INTERVAL=10
REQUIRE_TOOL_CONFIRMATION=true

# ------------------------------------------------------------
# Docker kaynak limitleri
# ------------------------------------------------------------
API_CPU_LIMIT=4
API_MEM_LIMIT=4g
WHISPER_MEM_LIMIT=6g
TTS_MEM_LIMIT=2g
QDRANT_MEM_LIMIT=2g
POSTGRES_MEM_LIMIT=1g

# ------------------------------------------------------------
# Electron (Vite dev server)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_WS_BASE_URL=ws://127.0.0.1:8080

# Authenticode (Faz 4). .pfx git'e yok. Self-signed yok.
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
# Azure Trusted Signing (hepsi dolu olmalı):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_CODE_SIGNING_ACCOUNT_NAME=
# AZURE_CERT_PROFILE_NAME=
