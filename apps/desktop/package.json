{
  "name": "@uryx/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Uryx — yerel Türkçe masaüstü yapay zekâ asistanı",
  "author": "Uryx",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "electron-updater": "^6.6.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.20.1"
  },
  "devDependencies": {
    "@uryx/shared-types": "*",
    "@tanstack/react-query": "^5.62.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.11.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
