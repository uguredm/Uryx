{
  "name": "uryx",
  "version": "1.0.0",
  "private": true,
  "description": "Uryx — yerel Türkçe masaüstü yapay zekâ asistanı (Electron + FastAPI + llama.cpp)",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @uryx/desktop",
    "build": "npm run build --workspace @uryx/shared-types && npm run build --workspace @uryx/desktop",
    "build:win": "npm run build --workspace @uryx/shared-types && npm run build:win --workspace @uryx/desktop",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
